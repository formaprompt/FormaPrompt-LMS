# Variables publiques utilisées uniquement par l'application React.
# La clé publique/anon Supabase n'est pas un secret, mais les règles RLS doivent rester actives.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=PUBLIC_ANON_KEY

# Domaine public utilisé par les liens de confirmation et de réinitialisation.
# Même en test local, les e-mails doivent rester ouvrables depuis un téléphone.
VITE_SITE_URL=https://formaprompt.com

# Lien public ou partagé de la bibliothèque remise aux apprenants.
VITE_PROMPT_LIBRARY_NOTION_URL=https://www.notion.so/REPLACE_ME

# Mesure des achats Google Ads : désactivée par défaut, activation après revue.
# Le code exige aussi une compilation production, le domaine FormaPrompt et le consentement.
# Aucun identifiant fourni ici n'est une clé secrète.
VITE_GOOGLE_ADS_PURCHASE_ENABLED=false

# GA4 audience : configuration publique, installation locale inactive par défaut.
VITE_GOOGLE_ANALYTICS_MEASUREMENT_ID=G-FL8HMVXF4Z
VITE_GOOGLE_ANALYTICS_ENABLED=false
# Ne passer à true qu'après revue réseau du vrai SDK, consentement et
# désactivation de toutes les mesures améliorées automatiques du flux GA4.
VITE_GOOGLE_ANALYTICS_PRIVACY_REVIEWED=false

# Supabase Edge Functions uniquement : ne jamais préfixer ces noms par VITE_.
# Configurer dans les secrets serveur ; aucune valeur sensible dans ce fichier.
# GOOGLE_CALENDAR_CLIENT_ID
# GOOGLE_CALENDAR_CLIENT_SECRET
# GOOGLE_CALENDAR_REFRESH_TOKEN
# GOOGLE_PROFESSIONAL_CALENDAR_ID : primaire professionnel explicite
# GOOGLE_PERSONAL_CALENDAR_ID : primaire personnel explicite déjà partagé en lecture
# GOOGLE_DIAGNOSTIC_CALENDAR_ID : destination professionnelle secondaire existante
# GOOGLE_COHORT_CALENDAR_ID : même destination professionnelle vérifiée
# GOOGLE_COURSE_USE_DIAGNOSTIC_CALENDAR : repli explicite existant
# GOOGLE_BUSY_CALENDAR_IDS n'est pas utilisé par le croisement unifié.
