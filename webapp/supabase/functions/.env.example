# Exemple local uniquement. Copier vers .env.local, qui reste ignoré par Git.
# Ne jamais mélanger une clé test avec un prix réel, ou inversement.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME
# Clé restreinte Stripe avec permission de lecture des PaymentIntents uniquement.
STRIPE_RECONCILIATION_READ_KEY=rk_test_REPLACE_ME
STRIPE_AI_ACT_PRICE_ID=price_REPLACE_ME
STRIPE_PROMPT_LEVEL1_PRICE_ID=price_REPLACE_ME
STRIPE_GENERATIVE_AI_PRICE_ID=price_REPLACE_ME
# Excel : ce fichier exemple reste vide. Le catalogue LIVE a ete cree et valide separement.
# Les references LIVE validees sont preparees localement dans .env.excel-live.local (ignore par Git).
# Ne pas utiliser les references LIVE pour un test de paiement ni charger ce fichier exemple en production.
STRIPE_EXCEL_INITIATION_INTER_PRICE_ID=
STRIPE_EXCEL_INITIATION_INDIVIDUEL_PRICE_ID=
STRIPE_EXCEL_PERFECTIONNEMENT_INTER_PRICE_ID=
STRIPE_EXCEL_PERFECTIONNEMENT_INDIVIDUEL_PRICE_ID=
STRIPE_EXCEL_AVANCE_INTER_PRICE_ID=
STRIPE_EXCEL_AVANCE_INDIVIDUEL_PRICE_ID=
SITE_URL=http://localhost:5173
